# Optional for public lessons and playground; required for saved learning progress.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase transaction-pooler URL. Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Direct or session-pooler URL for migrations (optional if DATABASE_URL is suitable).
MIGRATION_DATABASE_URL=
# Canonical origin. Use http://127.0.0.1:3417 locally and your free Vercel URL in production.
APP_ORIGIN=http://127.0.0.1:3417
# Optional self-hosted Postgres CA file; Supabase URLs use verified TLS by default.
DATABASE_CA_FILE=
# Optional aggregate site analytics. Off by default, never SDK telemetry.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
